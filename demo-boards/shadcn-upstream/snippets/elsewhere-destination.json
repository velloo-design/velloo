{
  "id": "elsewhere-destination",
  "name": "DestinationCard",
  "params": [
    {
      "name": "image",
      "type": "string"
    },
    {
      "name": "name",
      "type": "string"
    },
    {
      "name": "country",
      "type": "string"
    },
    {
      "name": "note",
      "type": "string"
    }
  ],
  "tree": {
    "$ref": "Card",
    "props": {
      "className": "overflow-hidden p-0 gap-0 rounded-2xl shadow-none"
    },
    "children": [
      {
        "$ref": "Box",
        "props": {
          "className": "relative h-[210px] overflow-hidden"
        },
        "children": [
          {
            "$ref": "Image",
            "props": {
              "src": {
                "$param": "image"
              },
              "fill": true,
              "className": "absolute inset-0 h-full w-full"
            }
          },
          {
            "$ref": "Button",
            "props": {
              "variant": "secondary",
              "size": "icon",
              "className": "absolute right-3 top-3 rounded-full size-8",
              "aria-label": "Save destination"
            },
            "children": [
              {
                "$ref": "Icon",
                "props": {
                  "name": "Heart",
                  "className": "size-4"
                }
              }
            ]
          }
        ]
      },
      {
        "$ref": "CardContent",
        "props": {
          "className": "p-5"
        },
        "children": [
          {
            "$ref": "Text",
            "props": {
              "children": {
                "$param": "country"
              },
              "className": "text-[10px] uppercase tracking-[0.18em] text-muted-foreground"
            }
          },
          {
            "$ref": "Box",
            "props": {
              "className": "flex items-center justify-between mt-2"
            },
            "children": [
              {
                "$ref": "Heading",
                "props": {
                  "children": {
                    "$param": "name"
                  },
                  "className": "font-display font-normal tracking-[-0.035em] text-3xl"
                }
              },
              {
                "$ref": "Icon",
                "props": {
                  "name": "ArrowUpRight",
                  "className": "size-4"
                }
              }
            ]
          },
          {
            "$ref": "Text",
            "props": {
              "children": {
                "$param": "note"
              },
              "className": "text-xs mt-2 text-muted-foreground"
            }
          }
        ]
      }
    ]
  }
}
