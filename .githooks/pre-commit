#!/usr/bin/env bash
#
# Repo pre-commit gate: run the same lint CI runs, so a formatting or
# organize-imports nit can't reach GitHub and fail the workflow.
#
# Enable once per clone with `git config core.hooksPath .githooks`.
# Bypass a single commit with `git commit --no-verify`.
#
set -euo pipefail

command -v bun >/dev/null 2>&1 || exit 0   # no bun -> don't block the commit

cd "$(git rev-parse --show-toplevel)"

if ! bun run lint; then
  {
    echo
    echo "  Lint failed — commit aborted (this is what CI runs)."
    echo "  Fix it with:"
    echo "      bun run lint:fix"
    echo "  Or bypass this once with:  git commit --no-verify"
  } >&2
  exit 1
fi
