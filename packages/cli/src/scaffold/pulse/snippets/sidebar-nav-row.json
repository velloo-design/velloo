{
  "id": "sidebar-nav-row",
  "name": "Sidebar Nav Row",
  "params": [
    {
      "name": "label",
      "type": "string"
    },
    {
      "name": "icon",
      "type": "string"
    },
    {
      "name": "badge",
      "type": "string",
      "default": ""
    },
    {
      "name": "active",
      "type": "boolean",
      "default": false
    }
  ],
  "tree": {
    "$ref": "Card",
    "props": {
      "className": {
        "$if": "active",
        "then": "flex flex-row items-center gap-3 px-3 py-2 rounded-md ring-0 shadow-none bg-accent text-accent-foreground font-medium cursor-default",
        "else": "flex flex-row items-center gap-3 px-3 py-2 rounded-md ring-0 shadow-none bg-transparent text-muted-foreground hover:bg-muted hover:text-foreground cursor-default"
      }
    },
    "children": [
      {
        "$ref": "Icon",
        "props": {
          "name": {
            "$param": "icon"
          },
          "size": 16
        }
      },
      {
        "$ref": "Text",
        "props": {
          "variant": "small",
          "className": "flex-1",
          "children": {
            "$param": "label"
          }
        }
      },
      {
        "$ref": "Text",
        "props": {
          "variant": "small",
          "className": {
            "$if": "badge",
            "then": "rounded-full bg-primary text-primary-foreground px-2 py-0.5 text-[10px] font-medium tabular-nums",
            "else": "hidden"
          },
          "children": {
            "$param": "badge"
          }
        }
      }
    ]
  }
}
