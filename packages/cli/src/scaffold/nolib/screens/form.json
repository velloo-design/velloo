{
  "id": "form",
  "name": "Sign up form",
  "tree": {
    "$ref": "Container",
    "props": { "size": "sm", "className": "py-16" },
    "children": [
      {
        "$ref": "Card",
        "props": { "className": "w-full" },
        "children": [
          {
            "$ref": "Stack",
            "props": { "gap": 4 },
            "children": [
              { "$ref": "Heading", "props": { "level": 2, "children": "Create an account" } },
              {
                "$ref": "Text",
                "props": { "variant": "muted", "children": "Designed without any UI library." }
              },
              {
                "$ref": "Stack",
                "props": { "gap": 2 },
                "children": [
                  { "$ref": "Text", "props": { "variant": "small", "children": "Email" } },
                  { "$ref": "Input", "props": { "placeholder": "you@company.com" } }
                ]
              },
              {
                "$ref": "Stack",
                "props": { "gap": 2 },
                "children": [
                  { "$ref": "Text", "props": { "variant": "small", "children": "Password" } },
                  {
                    "$ref": "Input",
                    "props": {
                      "type": "password",
                      "placeholder": "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022"
                    }
                  }
                ]
              },
              { "$ref": "Button", "props": { "variant": "default", "children": "Sign up" } }
            ]
          }
        ]
      }
    ]
  }
}
