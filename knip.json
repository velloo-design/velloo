{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", ".github/actions/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "scripts/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/cli.ts", "build.ts"]
    },
    "packages/canvas": {
      "entry": ["src/main.tsx", "src/server-export.ts", "vite.config.ts"]
    }
  },
  "ignore": ["**/*.css"],
  "ignoreDependencies": [
    "tailwindcss",
    "@biomejs/biome",
    "tw-animate-css",
    "sonner",
    "@types/diff",
    "playwright"
  ]
}
