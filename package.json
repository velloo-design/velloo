{
  "name": "velloo",
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Velloo \u2014 code-shaped design tool for developers",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter='*' run build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:dead": "knip",
    "format": "biome format --write .",
    "test": "bun test",
    "test:e2e": "VELLOO_E2E=1 bun test",
    "fonts:build": "bun packages/schema/scripts/build-font-catalog.ts",
    "fonts:check": "bun packages/schema/scripts/build-font-catalog.ts --check",
    "velloo": "bun packages/cli/src/cli.ts",
    "cli:build": "bun packages/cli/build.ts",
    "direct:build": "bun scripts/build-direct-artifact.ts",
    "release:build": "bun scripts/build-release-artifacts.ts",
    "release:smoke": "bun scripts/package-smoke-test.ts",
    "release:smoke:direct": "bun scripts/direct-install-smoke-test.ts",
    "cli:install": "bun scripts/cli-install.ts",
    "cli:watch": "bun scripts/cli-watch.ts",
    "cli:dev": "VELLOO_BUILD_CLOUD_URL=https://api.dev.velloo.ai bun scripts/cli-install.ts",
    "cli:prod": "VELLOO_BUILD_CLOUD_URL=https://api.velloo.ai bun scripts/cli-install.ts",
    "cli:release": "bun scripts/publish-cli.ts",
    "cli:release:dev": "bun scripts/publish-cli.ts dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "latest",
    "knip": "6.24.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
