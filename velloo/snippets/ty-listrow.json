{
  "id": "ty-listrow",
  "name": "Typeset list row",
  "params": [
    { "name": "name", "type": "string" },
    { "name": "meta", "type": "string" },
    { "name": "rowClass", "type": "string" }
  ],
  "tree": {
    "$ref": "Box",
    "props": { "className": { "$param": "rowClass" } },
    "children": [
      {
        "$ref": "Box",
        "props": {
          "as": "span",
          "className": "text-xs font-medium truncate",
          "children": { "$param": "name" }
        }
      },
      {
        "$ref": "Box",
        "props": {
          "as": "span",
          "className": "ml-auto font-mono text-[10px] text-muted-foreground shrink-0",
          "children": { "$param": "meta" }
        }
      }
    ]
  }
}
