{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.velloo-design/velloo",
  "title": "Velloo",
  "description": "Local design canvas for your coding agent: try screens in your app's own components, then ship one.",
  "websiteUrl": "https://velloo.design",
  "repository": {
    "url": "https://github.com/velloo-design/velloo",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://velloo.design/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://velloo.design/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "version": "0.10.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "velloo",
      "version": "0.10.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
